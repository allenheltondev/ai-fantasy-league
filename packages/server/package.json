{
  "name": "@fantasy/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Lambda API: operation registry, REST adapter, OpenAPI and MCP generators, auth, repositories.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./local": {
      "types": "./src/local.ts",
      "default": "./src/local.ts"
    }
  },
  "scripts": {
    "dev": "npm run build -w @fantasy/core && node --env-file=../../scripts/local.env --import tsx src/local.ts",
    "openapi": "npm run build -w @fantasy/core -w @fantasy/data && tsx --tsconfig tsconfig.json scripts/generate-openapi.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.1",
    "ajv": "^8.20.0",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1141.0",
    "@aws-sdk/client-eventbridge": "^3.1141.0",
    "@aws-sdk/client-ssm": "^3.1141.0",
    "@aws-sdk/credential-provider-node": "^3.972.84",
    "@aws-sdk/lib-dynamodb": "^3.1141.0",
    "@fantasy/core": "0.0.0",
    "@fantasy/data": "0.0.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@smithy/signature-v4": "^5.7.4",
    "aws-jwt-verify": "^5.2.1",
    "hono": "^4.13.9",
    "zod": "^4.6.5"
  }
}
