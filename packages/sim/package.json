{
  "name": "@fantasy/sim",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Season replay simulator: archives, the simulated clock, the as-of data guard, the headless runner, and the replay through the real league.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "sim:archive": "tsx --tsconfig tsconfig.json src/cli/archive.ts",
    "sim:run": "tsx --tsconfig tsconfig.json src/cli/run.ts",
    "sim:replay": "tsx --tsconfig tsconfig.json src/cli/replay.ts",
    "sim:eval": "tsx --tsconfig tsconfig.json src/cli/eval.ts",
    "sim:baseline": "tsx --tsconfig tsconfig.json src/cli/baseline.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fantasy/agents": "0.0.0",
    "@fantasy/core": "0.0.0",
    "@fantasy/data": "0.0.0",
    "@fantasy/server": "0.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
